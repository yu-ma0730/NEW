# コピーして .env を作成:  cp .env.example .env
# 1 にすると実際には投稿せず、予約〜投稿の流れだけ確認できます（最初はこれで試すのがおすすめ）
DRY_RUN=1

# 使う投稿先（カンマ区切り）。今は Threads だけ。X やブログも使うときは threads,x,blog
ENABLED_PLATFORMS=threads

# 画面の「🔑 アカウント連携」からログインする場合、下の認証情報は不要です。
# サーバーを https で公開してログインする場合だけ、その URL を設定（例: https://poster.example.com）
PUBLIC_URL=

# --- X（旧Twitter）: developer.x.com でアプリ作成 → 権限を「Read and write」にしてからトークン発行 ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Threads: Meta for Developers で Threads API アプリ作成（threads_basic, threads_content_publish 権限） ---
THREADS_ACCESS_TOKEN=

# --- ブログ（WordPress）: ユーザー → プロフィール → アプリケーションパスワード で発行 ---
WP_URL=https://example.com
WP_USER=
WP_APP_PASSWORD=
