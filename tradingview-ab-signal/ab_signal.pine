//@version=6
// ============================================================================
//  ハイトレ式 20/200EMA 手法 サインツール（非公式）
//
//  ハイトレFXさんの動画「移動平均線を使った高勝率手法」のルールを実装。
//
//    手順1 方向 : 20EMA > 200EMA なら買いだけ / 20EMA < 200EMA なら売りだけ
//    手順2 待つ : 価格が 200EMA にタッチするのを待つ
//    手順3 入る : きれいな斜めライン、またはダブルボトム/トップのネックラインを
//                 陽線（売りは陰線）の確定で抜けたらエントリー
//    損切り     : 200EMA タッチ後の押し安値（売りは戻り高値）= C
//    利確       : N計算値  TP = C ± (B − A)
//                 A = 最後の上昇（下降）波の起点、B = その波の終点
//    見送り     : リスクリワードが 1 以下 / 3 以上、利確が直近高値（安値）を
//                 超えない、AB が高値（安値）を更新していない
//
//  ※ 動画の説明をもとに自動判定しています。ラインの「きれいさ」など
//    裁量の部分は機械的な近似です。
// ============================================================================
indicator("ハイトレ式 20/200EMA 手法 サイン（非公式）", shorttitle = "HT EMA Signal", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_bars_back = 1000)

// ── 入力 ────────────────────────────────────────────────────────────────
grpM    = "移動平均線"
fastLen = input.int(20, "短期EMA", minval = 1, group = grpM)
slowLen = input.int(200, "長期EMA", minval = 1, group = grpM)

grpP     = "スイング検出（ライン・AB を探す用）"
pivLeft  = input.int(4, "ピボット 左バー数", minval = 1, group = grpP)
pivRight = input.int(2, "ピボット 右バー数（確定の遅れ）", minval = 1, group = grpP)

grpE       = "エントリー"
useTL      = input.bool(true, "斜めラインのブレイク", group = grpE)
useDB      = input.bool(true, "ダブルボトム/トップのネックライン ブレイク", group = grpE)
dbTolAtr   = input.float(0.5, "ダブルボトム/トップの高さの許容差（ATR×）", minval = 0.0, step = 0.1, group = grpE)
needCandle = input.bool(true, "陽線（売りは陰線）の確定でのみエントリー", group = grpE)
maxWait    = input.int(150, "200EMAタッチ後の最大待機バー数", minval = 1, maxval = 800, group = grpE)
abLookback = input.int(300, "B（波の終点）を探す最大バー数", minval = 10, maxval = 800, group = grpE)

grpF      = "見送りルール"
minRR     = input.float(1.0, "リスクリワードがこの値以下なら見送り", minval = 0.0, step = 0.1, group = grpF)
maxRR     = input.float(3.0, "リスクリワードがこの値以上なら見送り", minval = 0.1, step = 0.1, group = grpF)
needBeyond = input.bool(true, "利確目標が直近高値（安値）を超えないなら見送り", group = grpF)
needHH    = input.bool(true, "AB が高値（安値）を更新していないなら見送り", group = grpF)

grpD      = "表示"
showEma   = input.bool(true, "20EMA / 200EMA", group = grpD)
showTouch = input.bool(true, "200EMA タッチの印", group = grpD)
showSkip  = input.bool(true, "見送りの理由ラベル", group = grpD)
showAB    = input.bool(true, "A・B（N計算の値幅）", group = grpD)
showTable = input.bool(true, "状態パネル", group = grpD)
lineLen   = input.int(30, "TP/SL ラインの長さ（バー）", minval = 1, maxval = 400, group = grpD)
colBull   = input.color(#089981, "買い色", group = grpD)
colBear   = input.color(#F23645, "売り色", group = grpD)
colLine   = input.color(#9C27B0, "斜めライン/ネックラインの色", group = grpD)

// ── 移動平均線と方向 ───────────────────────────────────────────────────
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
upTrend = emaFast > emaSlow
dnTrend = emaFast < emaSlow
atr     = ta.atr(14)

var int crossBar = 0
if ta.cross(emaFast, emaSlow)
    crossBar := bar_index

plot(showEma ? emaFast : na, "20EMA", color = color.new(#2962FF, 0), linewidth = 1)
plot(showEma ? emaSlow : na, "200EMA", color = color.new(#43A047, 0), linewidth = 2)

// ── スイング高値・安値 ─────────────────────────────────────────────────
var array<float> phP = array.new<float>()
var array<int>   phX = array.new<int>()
var array<float> plP = array.new<float>()
var array<int>   plX = array.new<int>()

ph = ta.pivothigh(high, pivLeft, pivRight)
pl = ta.pivotlow(low, pivLeft, pivRight)
confirmed = barstate.isconfirmed

if confirmed and not na(ph)
    array.push(phP, ph)
    array.push(phX, bar_index - pivRight)
    if array.size(phP) > 100
        array.shift(phP)
        array.shift(phX)
if confirmed and not na(pl)
    array.push(plP, pl)
    array.push(plX, bar_index - pivRight)
    if array.size(plP) > 100
        array.shift(plP)
        array.shift(plX)

// ── 補助関数 ───────────────────────────────────────────────────────────
// startBar から現在までの最高値(dir=1) / 最安値(dir=-1) とそのバー
extremeSince(int startBar, int dir) =>
    int   len   = math.min(bar_index - startBar, abLookback)
    float best  = dir == 1 ? high : low
    int   bestX = bar_index
    for i = 0 to math.max(len, 0)
        float v = dir == 1 ? high[i] : low[i]
        if (dir == 1 and v > best) or (dir == -1 and v < best)
            best  := v
            bestX := bar_index - i
    [best, bestX]

// x より前で最後のピボットの位置（なければ -1）
lastBefore(array<int> xs, int x) =>
    int idx = -1
    int n = array.size(xs)
    if n > 0
        for i = n - 1 to 0
            if array.get(xs, i) < x
                idx := i
                break
    idx

// x より後のピボットのうち、最後の 2 つの位置 [1つ前, 最後]（なければ -1）
lastTwoAfter(array<int> xs, int x) =>
    int i1 = -1
    int i2 = -1
    int n = array.size(xs)
    if n > 0
        for i = n - 1 to 0
            if array.get(xs, i) <= x
                break
            if i2 == -1
                i2 := i
            else
                i1 := i
                break
    [i1, i2]

// 2 点を通る斜めラインの、バー x での値
lineAt(int x1, float y1, int x2, float y2, int x) =>
    y1 + (y2 - y1) * float(x - x1) / float(x2 - x1)

// 斜めラインを、現在の足より前の終値で一度も抜けていないか（= きれいなライン）
lineClean(int x1, float y1, int x2, float y2, int dir) =>
    bool ok = true
    int len = math.min(bar_index - x1 - 1, 900)
    if len >= 1
        for i = 1 to len
            float v = lineAt(x1, y1, x2, y2, bar_index - i)
            if (dir == 1 and close[i] > v) or (dir == -1 and close[i] < v)
                ok := false
                break
    ok

// xFrom〜xTo の最高値(dir=1) / 最安値(dir=-1)
extremeBetween(int xFrom, int xTo, int dir) =>
    float best = na
    for i = bar_index - xTo to math.min(bar_index - xFrom, 900)
        float v = dir == 1 ? high[i] : low[i]
        best := na(best) ? v : dir == 1 ? math.max(best, v) : math.min(best, v)
    best

// fromX より後、現在の足より前の終値が level を抜けていないか
closesInside(int fromX, float level, int dir) =>
    bool ok = true
    int len = math.min(bar_index - fromX - 1, 900)
    if len >= 1
        for i = 1 to len
            if (dir == 1 and close[i] > level) or (dir == -1 and close[i] < level)
                ok := false
                break
    ok

// 見送りの理由（空文字ならエントリー可）
skipReason(float rr, bool abOk, bool beyondOk, bool hhOk) =>
    string r = ""
    if not abOk
        r := "ABが見つからない"
    else if na(rr)
        r := "RRが計算できない"
    else if rr <= minRR
        r := "RR 1:" + str.tostring(rr, "#.##") + "（低すぎ）"
    else if rr >= maxRR
        r := "RR 1:" + str.tostring(rr, "#.##") + "（良すぎ）"
    else if needBeyond and not beyondOk
        r := "利確が直近の高値/安値に届かない"
    else if needHH and not hhOk
        r := "ABが高値/安値を更新していない"
    r

drawTrade(int dir, float entry, float sl, float tp, float rr, int ax, float ay, int bx, float by) =>
    color c = dir == 1 ? colBull : colBear
    line.new(bar_index, tp, bar_index + lineLen, tp, color = c, style = line.style_dashed)
    line.new(bar_index, sl, bar_index + lineLen, sl, color = color.gray, style = line.style_dashed)
    line.new(bar_index, entry, bar_index + lineLen, entry, color = color.new(color.gray, 50), style = line.style_dotted)
    label.new(bar_index + lineLen, tp, "TP " + str.tostring(tp, format.mintick), style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = size.small)
    label.new(bar_index + lineLen, sl, "SL " + str.tostring(sl, format.mintick), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.gray, size = size.small)
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "BUY" : "SELL") + "\nRR 1:" + str.tostring(rr, "#.##"),
         style = dir == 1 ? label.style_label_up : label.style_label_down, color = c, textcolor = color.white, size = size.small)
    if showAB
        line.new(ax, ay, bx, by, color = color.new(#FFB300, 0), width = 2)
        label.new(ax, ay, "A", style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(#FFB300, 20), textcolor = color.black, size = size.tiny)
        label.new(bx, by, "B", style = dir == 1 ? label.style_label_down : label.style_label_up, color = color.new(#FFB300, 20), textcolor = color.black, size = size.tiny)

drawSkip(int dir, string reason) =>
    if showSkip
        label.new(bar_index, dir == 1 ? low : high, "見送り\n" + reason, style = dir == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)

// ── 買い側の状態 ───────────────────────────────────────────────────────
var int   bState    = 0      // 0 = 待機, 1 = 200EMA タッチ後（ブレイク待ち）
var bool  bAway     = true   // 前回のセットアップ後に 200EMA から離れたか
var int   bLegStart = 0
var int   bTouchBar = na
var float bA        = na
var int   bAx       = na
var float bB        = na
var int   bBx       = na
var float bC        = na
var bool  bHH       = false

// ── 売り側の状態 ───────────────────────────────────────────────────────
var int   sState    = 0
var bool  sAway     = true
var int   sLegStart = 0
var int   sTouchBar = na
var float sA        = na
var int   sAx       = na
var float sB        = na
var int   sBx       = na
var float sC        = na
var bool  sHH       = false

bool buySig    = false
bool sellSig   = false
bool bTouchNow = false
bool sTouchNow = false

// ============================ 買い ============================
if confirmed
    // トレンドが変わったら/待ちすぎたら取り消し
    if bState == 1 and (not upTrend or bar_index - bTouchBar > maxWait)
        bState := 0
        bAway  := false
    if bState == 0 and low > emaSlow
        bAway := true

    // 手順2: 上方向で 200EMA にタッチ
    if bState == 0 and upTrend and bAway and low <= emaSlow
        bState    := 1
        bTouchNow := true
        bTouchBar := bar_index
        bC        := low
        [hb, hbx] = extremeSince(math.max(bLegStart, crossBar), 1)
        bB  := hb
        bBx := hbx
        int ia = lastBefore(plX, bBx)
        bA  := ia >= 0 ? array.get(plP, ia) : na
        bAx := ia >= 0 ? array.get(plX, ia) : na
        int ip = ia >= 0 ? lastBefore(phX, bAx) : -1
        bHH := ip < 0 or bB > array.get(phP, ip)
    else if bState == 1
        bC := math.min(bC, low)

    // 手順3: 斜めライン / ダブルボトムのブレイク
    if bState == 1 and bar_index > bTouchBar and (not needCandle or close > open)
        bool  tlHit = false
        int   tx1   = na
        float ty1   = na
        float tv    = na
        if useTL
            [i1, i2] = lastTwoAfter(phX, bBx)
            if i2 >= 0
                int   x1 = i1 >= 0 ? array.get(phX, i1) : bBx
                float y1 = i1 >= 0 ? array.get(phP, i1) : bB
                int   x2 = array.get(phX, i2)
                float y2 = array.get(phP, i2)
                if x2 > x1 and y2 < y1
                    tv    := lineAt(x1, y1, x2, y2, bar_index)
                    tlHit := close > tv and lineClean(x1, y1, x2, y2, 1)
                    tx1   := x1
                    ty1   := y1
        bool  dbHit = false
        int   nx1   = na
        float neck  = na
        if useDB and not tlHit
            [j1, j2] = lastTwoAfter(plX, bBx)
            if j1 >= 0
                int lx1 = array.get(plX, j1)
                int lx2 = array.get(plX, j2)
                if math.abs(array.get(plP, j1) - array.get(plP, j2)) <= dbTolAtr * atr and lx2 - lx1 >= 2
                    neck  := extremeBetween(lx1, lx2, 1)
                    dbHit := close > neck and closesInside(lx2, neck, 1)
                    nx1   := lx1

        if tlHit or dbHit
            if tlHit
                line.new(tx1, ty1, bar_index, tv, color = colLine, width = 2)
            else
                line.new(nx1, neck, bar_index, neck, color = colLine, width = 2)
            bool  abOk = not na(bA) and bB > bA
            float sl   = bC
            float tp   = abOk ? bC + (bB - bA) : na
            float risk = close - sl
            float rr   = abOk and risk > 0 ? (tp - close) / risk : na
            string reason = skipReason(rr, abOk, abOk and tp > bB, bHH)
            if reason == ""
                buySig := true
                drawTrade(1, close, sl, tp, rr, bAx, bA, bBx, bB)
                alert("ハイトレ式 買い " + syminfo.ticker + " | Entry " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick) + " | RR 1:" + str.tostring(rr, "#.##"), alert.freq_once_per_bar_close)
            else
                drawSkip(1, reason)
            bState    := 0
            bAway     := false
            bLegStart := bar_index

// ============================ 売り ============================
if confirmed
    if sState == 1 and (not dnTrend or bar_index - sTouchBar > maxWait)
        sState := 0
        sAway  := false
    if sState == 0 and high < emaSlow
        sAway := true

    // 手順2: 下方向で 200EMA にタッチ
    if sState == 0 and dnTrend and sAway and high >= emaSlow
        sState    := 1
        sTouchNow := true
        sTouchBar := bar_index
        sC        := high
        [lb, lbx] = extremeSince(math.max(sLegStart, crossBar), -1)
        sB  := lb
        sBx := lbx
        int ia = lastBefore(phX, sBx)
        sA  := ia >= 0 ? array.get(phP, ia) : na
        sAx := ia >= 0 ? array.get(phX, ia) : na
        int ip = ia >= 0 ? lastBefore(plX, sAx) : -1
        sHH := ip < 0 or sB < array.get(plP, ip)
    else if sState == 1
        sC := math.max(sC, high)

    // 手順3: 切り上げライン / ダブルトップのブレイク
    if sState == 1 and bar_index > sTouchBar and (not needCandle or close < open)
        bool  tlHit = false
        int   tx1   = na
        float ty1   = na
        float tv    = na
        if useTL
            [i1, i2] = lastTwoAfter(plX, sBx)
            if i2 >= 0
                int   x1 = i1 >= 0 ? array.get(plX, i1) : sBx
                float y1 = i1 >= 0 ? array.get(plP, i1) : sB
                int   x2 = array.get(plX, i2)
                float y2 = array.get(plP, i2)
                if x2 > x1 and y2 > y1
                    tv    := lineAt(x1, y1, x2, y2, bar_index)
                    tlHit := close < tv and lineClean(x1, y1, x2, y2, -1)
                    tx1   := x1
                    ty1   := y1
        bool  dbHit = false
        int   nx1   = na
        float neck  = na
        if useDB and not tlHit
            [j1, j2] = lastTwoAfter(phX, sBx)
            if j1 >= 0
                int lx1 = array.get(phX, j1)
                int lx2 = array.get(phX, j2)
                if math.abs(array.get(phP, j1) - array.get(phP, j2)) <= dbTolAtr * atr and lx2 - lx1 >= 2
                    neck  := extremeBetween(lx1, lx2, -1)
                    dbHit := close < neck and closesInside(lx2, neck, -1)
                    nx1   := lx1

        if tlHit or dbHit
            if tlHit
                line.new(tx1, ty1, bar_index, tv, color = colLine, width = 2)
            else
                line.new(nx1, neck, bar_index, neck, color = colLine, width = 2)
            bool  abOk = not na(sA) and sA > sB
            float sl   = sC
            float tp   = abOk ? sC - (sA - sB) : na
            float risk = sl - close
            float rr   = abOk and risk > 0 ? (close - tp) / risk : na
            string reason = skipReason(rr, abOk, abOk and tp < sB, sHH)
            if reason == ""
                sellSig := true
                drawTrade(-1, close, sl, tp, rr, sAx, sA, sBx, sB)
                alert("ハイトレ式 売り " + syminfo.ticker + " | Entry " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick) + " | RR 1:" + str.tostring(rr, "#.##"), alert.freq_once_per_bar_close)
            else
                drawSkip(-1, reason)
            sState    := 0
            sAway     := false
            sLegStart := bar_index

// ── 印・アラート ───────────────────────────────────────────────────────
plotshape(showTouch and bTouchNow ? emaSlow : na, "200EMAタッチ（買い方向）", shape.circle, location.absolute, color.new(colBull, 30), size = size.tiny)
plotshape(showTouch and sTouchNow ? emaSlow : na, "200EMAタッチ（売り方向）", shape.circle, location.absolute, color.new(colBear, 30), size = size.tiny)
plotshape(buySig, "買いサイン", shape.triangleup, location.belowbar, colBull, size = size.tiny)
plotshape(sellSig, "売りサイン", shape.triangledown, location.abovebar, colBear, size = size.tiny)

alertcondition(buySig, "買いサイン", "ハイトレ式 買いサイン: {{ticker}} {{interval}} 終値 {{close}}")
alertcondition(sellSig, "売りサイン", "ハイトレ式 売りサイン: {{ticker}} {{interval}} 終値 {{close}}")
alertcondition(bTouchNow or sTouchNow, "200EMAタッチ（準備）", "ハイトレ式 200EMAタッチ: {{ticker}} {{interval}} ラインを引く準備")

// ── 状態パネル ─────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 3, bgcolor = color.new(color.black, 25), border_width = 1)
if showTable and barstate.islast
    string dirTxt = upTrend ? "上方向（買いのみ）" : dnTrend ? "下方向（売りのみ）" : "―"
    color  dirCol = upTrend ? colBull : dnTrend ? colBear : color.gray
    string stTxt  = bState == 1 ? "200EMAタッチ済み → ブレイク待ち" : sState == 1 ? "200EMAタッチ済み → ブレイク待ち" : "200EMAタッチ待ち"
    string nTxt   = bState == 1 and not na(bA) ? "AB " + str.tostring(bB - bA, format.mintick) + " / SL " + str.tostring(bC, format.mintick) :
         sState == 1 and not na(sA) ? "AB " + str.tostring(sA - sB, format.mintick) + " / SL " + str.tostring(sC, format.mintick) : "―"
    table.cell(info, 0, 0, "方向（20/200EMA）", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, dirTxt, text_color = dirCol, text_size = size.small)
    table.cell(info, 0, 1, "状態", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, stTxt, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 2, "N計算", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 2, nTxt, text_color = color.white, text_size = size.small)
